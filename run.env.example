# Copy to run.env (gitignored) if this machine needs anything unusual.
# Everything here is optional; without it Galley uses uv's own defaults.

# Where uv puts the virtualenv. Worth setting when $HOME is small, slow, or
# backed up — and *not* worth pointing at a directory that gets reaped.
# UV_PROJECT_ENVIRONMENT=/scratch/users/$USER/venvs/galley

# Where latexmk and latexdiff put their scratch files. A LaTeX build of a real
# paper writes a lot of them.
# TMPDIR=/scratch/temp/$USER
